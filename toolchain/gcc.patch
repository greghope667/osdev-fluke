diff '--color=auto' -rupN gcc-16.2.0/gcc/config/fluke.h gcc/gcc/config/fluke.h
--- gcc-16.2.0/gcc/config/fluke.h	1970-01-01 01:00:00.000000000 +0100
+++ gcc/gcc/config/fluke.h	2026-09-11 20:15:51.280046225 +0100
@@ -0,0 +1,28 @@
+/* Useful if you wish to make target-specific GCC changes. */
+#undef TARGET_FLUKE
+#define TARGET_FLUKE 1
+
+// #undef LIB_SPEC
+// #define LIB_SPEC "-lc"
+//
+// #undef STARTFILE_SPEC
+// #define STARTFILE_SPEC "crt0.o%s crti.o%s crtbegin.o%s"
+//
+// #undef ENDFILE_SPEC
+// #define ENDFILE_SPEC "crtend.o%s crtn.o%s"
+
+// #undef LINK_SPEC
+// #define LINK_SPEC "%{shared:-shared} %{static:-static} %{!shared: %{!static: %{rdynamic:-export-dynamic}}}"
+// #undef LINK_SPEC
+// #define LINK_SPEC "-z max-page-size=4096"
+
+/* Additional predefined macros. */
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()      \
+do {                                  \
+    builtin_define ("__fluke__");     \
+    builtin_define ("__unix__");      \
+    builtin_assert ("system=fluke");  \
+    builtin_assert ("system=unix");   \
+    builtin_assert ("system=posix");  \
+} while(0);
diff '--color=auto' -rupN gcc-16.2.0/gcc/config.gcc gcc/gcc/config.gcc
--- gcc-16.2.0/gcc/config.gcc	2026-08-07 08:46:05.819684556 +0100
+++ gcc/gcc/config.gcc	2026-09-11 23:26:18.681655667 +0100
@@ -932,6 +932,13 @@ case ${target} in
   rust_target_objs="${rust_target_objs} freebsd-rust.o"
   target_has_targetrustm=yes
   ;;
+*-*-fluke*)
+  extra_options="$extra_options gnu-user.opt"
+  gas=yes
+  gnu_ld=yes
+  default_use_cxa_atexit=yes
+  use_gcc_stdint=none
+  ;;
 *-*-fuchsia*)
   native_system_header_dir=/include
   tmake_file="t-fuchsia"
@@ -2373,6 +2380,9 @@ i[34567]86-*-mingw* | x86_64-*-mingw*)
 			;;
 	esac
 	;;
+x86_64-*-fluke*)
+	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h glibc-stdint.h i386/i386elf.h i386/x86-64.h fluke.h gnu-user.h"
+	;;
 x86_64-*-fuchsia*)
 	tmake_file="${tmake_file} i386/t-x86_64-elf"
 	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h newlib-stdint.h i386/i386elf.h i386/x86-64.h fuchsia.h"
